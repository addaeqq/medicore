# Copy to `.env` to override the demo defaults in docker-compose.yml.
# `.env` is gitignored — never commit real credentials (NFR-SEC-05).
# This is also the variable set to configure on Railway (see DEPLOYMENT.md §3).

# --- database ---------------------------------------------------------------
DB_USER=medicore
DB_PASS=medicore_dev
DB_NAME=medicore

# --- host port mappings (change if something already owns these) ------------
WEB_HOST_PORT=3000
API_HOST_PORT=4000
DB_HOST_PORT=5433

# --- API --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
# Demo data ON. Drop `,classpath:db/seed` for a real-data deployment.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# HTTPS deployments (Railway): COOKIE_SECURE=true. SameSite stays `lax` because
# the browser only ever talks to the web origin — /api/* is proxied (DD-02).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- ITC Transflow payments (DD-07) ----------------------------------------
# UAT default shown; LIVE is https://apis.itcsrvc.com/checkout
ITC_BASE_URL=https://apisuat.itcsrvc.com/checkout
ITC_API_KEY=
ITC_MERCHANT_PRODUCT_ID=
ITC_TRANSFLOW_ID=
# Must be publicly reachable for callbacks to arrive. Locally they will not —
# settle the invoice with POST /api/payments/{id}/verify instead (NFR-SEC-06).
ITC_CALLBACK_URL=http://localhost:4000/api/payments/callback
ITC_SUCCESS_URL=http://localhost:3000/payments/success
ITC_FAILURE_URL=http://localhost:3000/payments/failure

# --- SMTP (DD-08, optional) -------------------------------------------------
# Leave blank to run without mail: outbox rows are marked `skipped`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
